LUNIT_FM_API_KEY=
LUNIT_FM_API_URL=https://model.hackathon.lunit.io
LUNIT_FM_MODEL=Lunit/L2-preview
LUNIT_MCP_URL=https://mcp.hackathon.lunit.io/mcp
DRIVER_MODEL_ID=lunit-hackathon-driver

# Local evaluation only; not used by the submission service
HEALTHBENCH_JUDGE_API_KEY=

# Optional budgets and timeouts
UPSTREAM_TIMEOUT_SECONDS=75
REQUEST_TIMEOUT_SECONDS=170
RETRIEVAL_TIMEOUT_SECONDS=65
FINAL_GENERATION_RESERVE_SECONDS=75
MCP_TOOL_TIMEOUT_SECONDS=25
MCP_TERMINATE_ON_CLOSE=false
UPSTREAM_RETRIES=1
# Normal slots plus one additional RAG final-answer priority slot
UPSTREAM_CONCURRENCY=2
UPSTREAM_PRIORITY_SLOTS=1
RETRY_BASE_SECONDS=0.5
RETRY_MAX_SECONDS=8
MAX_GENERATION_ROUNDS=3
MAX_RETRIEVALS_PER_ANSWER=1
MAX_RETRIEVAL_MODEL_ROUNDS=5
MAX_RETRIEVAL_MCP_CALLS=3
MAX_MCP_RESULT_CHARS=8000
MAX_RETRIEVAL_CONTEXT_CHARS=20000
MAX_EVIDENCE_CHARS=16000
MAX_SELECTED_EVIDENCE=2
CITATION_REPAIR_MIN_SECONDS=15
